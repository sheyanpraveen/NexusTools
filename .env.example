# NexusTools Environment Configuration

# 1. Your Live Website URL (Without trailing slash '/')
# Example for Vercel preview: https://your-project.vercel.app
# Example for Custom Domain: https://nexustools.io
NEXT_PUBLIC_SITE_URL=https://nexustools.io

# 2. Google Analytics 4 Measurement ID (Optional initially, add when ready)
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
